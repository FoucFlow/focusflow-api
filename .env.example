# FocusFlow API settings. Production: /opt/focusflow/.env on the VPS (root-only).
# production enables Secure cookies + release mode
APP_ENV=development
PORT=8091
LOG_LEVEL=info
DATABASE_URL=postgres://focusflow:focusflow@localhost:5432/focusflow?sslmode=disable
# 32+ random chars: openssl rand -hex 32
APP_KEY=
PUBLIC_URL=http://localhost:8091
FRONTEND_URL=http://localhost:3000
SESSION_TTL_DAYS=30

# Seeded admin (created once if the email does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Home-page contact form messages go here (empty = ADMIN_EMAIL)
CONTACT_EMAIL=

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Mail: production uses the existing Zoho account (port 465 = implicit TLS).
# Empty SMTP_HOST logs emails instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=FocusFlow

# Thumbnails and avatars: RustFS bucket on the VPS (S3 API)
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
AWS_REGION=us-east-1
AWS_BUCKET_NAME=focusflow-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Lessons and quizzes
YOUTUBE_API_KEY=
# empty = quiz and reflection endpoints return 503
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_GRADE_MODEL=

# Traces to the VPS Alloy collector (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
